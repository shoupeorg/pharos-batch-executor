{
  "name": "pharos-batch-executor",
  "main": "worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pharos-batch-executor", "database_id": "77847f5e-26e1-4687-8ba4-4218c2985478", "migrations_dir": "migrations" }],
  "vars": {
    "RPC_URL": "https://rpc.pharos.xyz",
    "ENGINE_VERSION": "batch-executor/1.0.0",
    "CHAIN_ID": "1672",
    "BATCH_CONTRACT": "0xcA11bde05977b3631167028862bE2a173976CA11"
  },
  "observability": { "enabled": true }
}
